# Embedder configuration (env prefix RENFILD_EMB_). Copy to /opt/renfild/etc/embedder.env.
RENFILD_EMB_HOST=127.0.0.1
RENFILD_EMB_PORT=8100
RENFILD_EMB_LOG_LEVEL=INFO
RENFILD_EMB_MODEL_SOURCE=speechbrain/spkrec-ecapa-voxceleb
RENFILD_EMB_MODEL_DIR=/opt/renfild/embedder/models/spkrec-ecapa-voxceleb
RENFILD_EMB_TORCH_THREADS=3
